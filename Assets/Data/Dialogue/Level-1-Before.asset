  - speaker: {fileID: 11400000, guid: 6a62e8167ff1c4b4e8d13bbee87ea73f, type: 2}
    text: "\u6839\u636E\u60C5\u62A5\u5206\u6790\uFF0C\u8BE5\u54E8\u5361\u4E3A\u524D\u5F80<color=red>\u201C\u5E7D\u7075\u201D</color>\u7684\u5FC5\u7ECF\u4E4B\u8DEF\uFF0C\u731C\u6D4B\u53EF\u80FD\u662F\u534E\u7EA6\u4E13\u4E3A<color=red>\u201C\u5E7D\u7075\u201D</color>\u8BBE\u7ACB\u7684<color=yellow>\u68C0\u67E5\u54E8\u5361</color>\u3002<!wait=0.5>\n\u76EE\u524D\u4ECD\u6709\u90E8\u5206\u4E1C\u5FB7\u58EB\u5175\u9A7B\u7559\u628A\u5B88\u2026\u2026"
    portraits:
    - character: {fileID: 11400000, guid: 54c83d60e19f8bd4c99a1626c16ccf46, type: 2}
      position: 0
      poseOverride: 
      skinOverride: 
      oneShotPose: 
    - character: {fileID: 11400000, guid: 6a62e8167ff1c4b4e8d13bbee87ea73f, type: 2}
      position: 2
      poseOverride: 
      skinOverride: 
      oneShotPose: 
  - speaker: {fileID: 11400000, guid: ee4ecb61faf59154e871028aa9f33cbc, type: 2}
    text: "<grow>\u6E05\u7A7A\u8BE5\u54E8\u5361\uFF0C\u4E0D\u7559\u6D3B\u53E3\uFF0C</grow>\u907F\u514D\u5176\u968F\u540E\u652F\u63F4<color=red>\u201C\u5E7D\u7075\u201D</color>\u7684\u53EF\u80FD\u3002\u540C\u65F6\u521D\u6B65\u83B7\u53D6\u60C5\u62A5\uFF0C\u6709\u4EFB\u4F55\u7279\u6B8A\u60C5\u51B5\u7ACB\u523B\u8FDB\u884C\u4E0A\u62A5\u3002"
    portraits:
    - character: {fileID: 11400000, guid: 54c83d60e19f8bd4c99a1626c16ccf46, type: 2}
      position: 0
      poseOverride: 
      skinOverride: 
