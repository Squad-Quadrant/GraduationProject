  - speaker: {fileID: 11400000, guid: 6a62e8167ff1c4b4e8d13bbee87ea73f, type: 2}
    text: "\u2026\u2026\u603B\u4E4B\u5C31\u662F\u8FD9\u6837\uFF0C\u4F60\u4EEC\u514D\u4E0D\u4E86\u4E00\u573A\u5927\u6218\u5566\uFF0C\u4F46\u6211\u76F8\u4FE1\u4F60\u4EEC\u3002<!wait=0.8>\u4E0D\u8FC7\uFF0C\u4E0D\u5FC5\u62C5\u5FC3\u54E8\u5361\u5185\u58EB\u5175\u9047\u88AD\u540E\u4E0E\u5176\u603B\u90E8\u8054\u7EDC\u7684\u53EF\u80FD\u3002<grow><color=green>Spectra</color></grow>\u7684\u968F\u8EAB\u8BBE\u5907\u91CC\uFF0C\u914D\u5907\u4E86\u6700\u65B0\u7814\u5236\u7684<color=yellow>\u8BD5\u9A8C\u578B\u5355\u5175\u901A\u8BAF\u5E72\u6270\u8BBE\u5907</color>\uFF0C\u53EF\u4EE5\u6709\u6548\u5E72\u6270\u4E00\u5B9A\u8303\u56F4\u5185\u7279\u5B9A\u7684\u901A\u8BAF\u9891\u6BB5\u3002\u653E\u5F00\u624B\u811A\u5730\u6765\u4E00\u573A\u7A81\u88AD\u5427\u3002"
