  nodes:
  - speaker: {fileID: 0}
    text: "\u4E1C\u5FB7\u83F2\u897F\u7279\u5C14\u5C71\u8109\uFF0C\u524D\u5F80<color=red>\u201C\u5E7D\u7075\u201D</color>\u9014\u4E2D\uFF0C\u4E00\u4E1C\u5FB7\u54E8\u5361\u524D"
    portraits: []
  - speaker: {fileID: 11400000, guid: 54c83d60e19f8bd4c99a1626c16ccf46, type: 2}
    text: "<wave>\uFF08\u4F7F\u7528\u65E0\u7EBF\u7535\u901A\u8BAF\uFF09</wave><!wait=1>
      \u6307\u6325\u90E8\uFF0C\u8FD9\u91CC\u662F<color=green>\u5E7D\u7075\u884C\u52A8\u5C0F\u961F</color>\u3002\u524D\u65B9\u51FA\u73B0\u4E00\u5904<color=yellow>\u4E1C\u5FB7\u54E8\u5361</color>\uFF0C\u8BF7\u6307\u793A\u3002"
