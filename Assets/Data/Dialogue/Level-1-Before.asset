  - speaker: {fileID: 11400000, guid: e9b5b4bce4cbcc64e95fb38cba404ae2, type: 2}
    text: "\u6B63\u5E38\u8FD0\u4F5C\u5012\u662F\u6CA1\u95EE\u9898\uFF0C<!wait=0.5>\u4F46\u6BD5\u7ADF\u662F\u8BD5\u9A8C\u578B\uFF0C\u8FD8\u662F\u7528<color=yellow>\u8D85\u5E38\u539F\u7406</color>\u5236\u4F5C\u7684\uFF0C\u7A0D\u5FAE\u6709\u4E9B\u4E0D\u592A\u7A33\u5B9A\uFF0C\u4E0D\u4FBF\u957F\u65F6\u95F4\u5F00\u542F\u3002\u4E0D\u8FC7\uFF0C\u5012\u4E5F\u4E0D\u81F3\u4E8E\u7A81\u7136<swing>\u62A5\u5E9F</swing>\u628A\u6211\u4EEC\u5356\u4E86\u5C31\u662F\u4E86\u3002"
