    text: "\u6240\u4EE5\u6307\u6325\u90E8\u7684\u610F\u601D\u662F\u8BA9\u6211\u4EEC<grow>\u4E09\u4E2A\u4EBA\u6E05\u7A7A\u4E00\u5EA7\u5C97\u54E8\uFF1F</grow><shake>\u8FD9\u4E48\u4F1A\u8BF4\u5927\u8BDD\u4ED6\u600E\u4E48\u4E0D\u81EA\u5DF1\u6765\uFF1F</shake>"
